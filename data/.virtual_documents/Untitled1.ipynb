recall_results = []

for question_id, group in labels_df.groupby("question_id"):
    question_id = int(question_id)

    relevant_in_top5 = int(group["relevant"].sum())
    total_relevant = total_relevant_chunks[question_id]

    recall_at_5 = relevant_in_top5 / total_relevant

    recall_results.append({
        "question_id": question_id,
        "question": group["question"].iloc[0],
        "relevant_in_top5": relevant_in_top5,
        "total_relevant_chunks": total_relevant,
        "Recall@5": recall_at_5
    })

recall_df = pd.DataFrame(recall_results)

display(recall_df)

print("Mean Recall@5:", recall_df["Recall@5"].mean())
print("Mean Recall@5 (%):", recall_df["Recall@5"].mean() * 100)



