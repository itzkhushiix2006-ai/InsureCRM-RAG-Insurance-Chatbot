import chromadb
import pandas as pd

from langchain_huggingface import HuggingFaceEmbeddings

# Connect to the existing persistent ChromaDB
chroma_client = chromadb.PersistentClient(path="./chroma_db")

collection = chroma_client.get_collection(
    name="insurance_documents"
)

print("Connected to ChromaDB")
print("Total stored chunks:", collection.count())


embedding_model = HuggingFaceEmbeddings(
    model_name="sentence-transformers/all-MiniLM-L6-v2"
)

def retrieve_chunks(question, k=5):
    query_embedding = embedding_model.embed_query(question)

    result = collection.query(
        query_embeddings=[query_embedding],
        n_results=k,
        include=["documents", "metadatas", "distances"]
    )

    documents = result["documents"][0]
    metadatas = result["metadatas"][0]
    distances = result["distances"][0]

    retrieved = []

    for i, document in enumerate(documents):
        retrieved.append({
            "rank": i + 1,
            "chunk": document,
            "metadata": metadatas[i],
            "distance": distances[i]
        })

    return retrieved

print("Retrieval function ready")


answer_eval_df = pd.read_csv(
    "answer_evaluation.csv",
    encoding="cp1252"
)

questions = (
    answer_eval_df["Question"]
    .dropna()
    .astype(str)
    .str.strip()
    .drop_duplicates()
    .tolist()
)

print("Total unique evaluation questions:", len(questions))

for i, question in enumerate(questions, start=1):
    print(f"Q{i}: {question}")


retrieval_rows = []

for q_num, question in enumerate(questions, start=1):
    retrieved = retrieve_chunks(question, k=5)

    for item in retrieved:
        retrieval_rows.append({
            "question_id": q_num,
            "question": question,
            "rank": item["rank"],
            "chunk": item["chunk"],
            "metadata": str(item["metadata"]),
            "distance": item["distance"]
        })

retrieval_df = pd.DataFrame(retrieval_rows)

display(
    retrieval_df[
        ["question_id", "question", "rank", "chunk", "metadata"]
    ]
)


retrieval_df["relevant"] = ""

display(
    retrieval_df[
        ["question_id", "rank", "question", "chunk", "relevant"]
    ]
)

retrieval_df.to_csv("precision_recall_labeling.csv", index=False)

print("Saved blank labeling sheet: precision_recall_labeling.csv")


missing_labels = labels_df[labels_df["relevant"].isna()]

print("Rows needing labels:", len(missing_labels))

for _, row in missing_labels.iterrows():
    print("\nQuestion ID:", row["question_id"])
    print("Rank:", row["rank"])
    print("Question:", row["question"])
    print("Chunk:\n", row["chunk"])
    print("-" * 80)


labels_df = pd.read_csv("precision_recall_labeling.csv")

labels_df["relevant"] = pd.to_numeric(
    labels_df["relevant"],
    errors="coerce"
)

if labels_df["relevant"].isna().any():
    print("Labels abhi bhi missing hain. CSV mein blanks fill karo.")
else:
    print("All relevance labels loaded successfully.")


# Enter the verified total number of relevant chunks
# for each question across the complete document collection.

total_relevant_chunks = {
    1: None,  # Q1
    2: None,  # Q2
    3: None,  # Q3
    4: None,  # Q4
    5: None   # Q5
}


K = 5

precision_results = []

for question_id, group in labels_df.groupby("question_id"):
    relevant_retrieved = int(group["relevant"].sum())

    precision_results.append({
        "question_id": int(question_id),
        "question": group["question"].iloc[0],
        "relevant_in_top5": relevant_retrieved,
        "Precision@5": relevant_retrieved / K
    })

precision_df = pd.DataFrame(precision_results)

display(precision_df)

print("Mean Precision@5:", precision_df["Precision@5"].mean())


# Save per-question Precision@5 results
precision_df.to_csv("precision_at_5_results.csv", index=False)

# Create and save the mean Precision@5 summary
mean_precision = precision_df["Precision@5"].mean()

precision_summary = pd.DataFrame({
    "Metric": ["Mean Precision@5"],
    "Score": [mean_precision],
    "Percentage": [mean_precision * 100]
})

display(precision_summary)

precision_summary.to_csv("precision_at_5_summary.csv", index=False)

print("Saved: precision_at_5_results.csv")
print("Saved: precision_at_5_summary.csv")


